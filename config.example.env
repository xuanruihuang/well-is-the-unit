# Copy to config.env and edit. Read by code/config.py and sourced by pipelines/run_all.sh; an environment variable of
# the same name takes precedence.

# Root of the raw data, intermediate arrays and outputs, laid out as in README ("Layout"). The analyses ran on two
# machines (Tahoe-100M on one, Emerald Bay, OP3 and sci-Plex3 on the other); here both use the same root.
WORKSPACE=/path/to/workspace

# Python interpreter of the analysis environment (requirements.txt), and worker processes for the extraction steps.
PYTHON=python3
WORKERS=16
